# Enterprise standalone image — client pulls on their schedule.
# Build: docker build -f Dockerfile.standalone -t lazarus-standalone:latest .
FROM node:22-bookworm-slim

WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --omit=dev
COPY . .
RUN npm run build

ENV NODE_ENV=production
ENV STANDALONE_INSTALL=true
EXPOSE 3001
CMD ["npm", "start"]
